# Sentry
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# Supabase (required — app crashes if missing, no defaults)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Trello (required — app crashes if missing, no defaults)
TRELLO_API_KEY=

# Trello API base URL (config value — defaults to https://api.trello.com/1)
TRELLO_API_BASE_URL=https://api.trello.com/1

# OpenAI (required — app crashes if missing, no defaults)
OPENAI_API_KEY=

# AI model (config value, not a secret — may default to gpt-4o)
AI_MODEL=gpt-4o

# Google OAuth (local Supabase only — read by supabase/config.toml)
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_SECRET=